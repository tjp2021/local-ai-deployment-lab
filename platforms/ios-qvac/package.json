{
  "name": "ios-qvac-runner",
  "version": "0.1.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "export:inputs": "cd ../.. && node --import tsx scripts/export-mobile-inputs.ts",
    "bundle:worker": "node scripts/bundle-worker.mjs",
    "prepare:run": "npm run export:inputs && npm run bundle:worker",
    "ios": "expo run:ios --device"
  },
  "dependencies": {
    "@qvac/sdk": "0.15.0",
    "expo": "~57.0.4",
    "expo-build-properties": "~57.0.3",
    "expo-device": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-bare-kit": "^0.11.5"
  },
  "devDependencies": {
    "bare-pack": "^1.5.1"
  }
}
