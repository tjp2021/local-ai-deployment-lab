{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "adapters/**/*.ts",
    "contracts/**/*.ts",
    "runner/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts"
  ]
}
