{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-ai-deployment-lab.example/schemas/model-output-1.0.json",
  "title": "Local AI Deployment Lab Model Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "category",
    "severity",
    "missingInformation",
    "recommendedAction",
    "requiresHumanReview",
    "suggestedProcessing"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "category": {
      "enum": ["delivery", "account", "fraud", "technical", "unknown"]
    },
    "severity": {
      "enum": ["low", "medium", "high", "critical"]
    },
    "missingInformation": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "uniqueItems": true
    },
    "recommendedAction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "requiresHumanReview": {
      "type": "boolean"
    },
    "suggestedProcessing": {
      "enum": ["local", "cloud", "human_review"]
    }
  }
}

